#!/bin/bash

APPS_DIR="$HOME/Applications"
DESKTOP_DIR="$HOME/.local/share/applications"
FLATPAK_REMOTES_URL="https://flathub.org"

show_help() {
    cat << EOF
Usage: linapp [OPTION] [ARGUMENTS]

Options:
  --install-flatpak <app_id> <name>    Isolate and manage a Flatpak application
  --remove-flatpak <app_id> <name>     Completely remove an isolated Flatpak app
  --help                               Show this help message

GUI Usage:
  Double-click on any .deb, .tar.gz or .AppImage file to install via linapp.
EOF
}

install_flatpak() {
    local app_id="$1"
    local app_name="$2"

    if [ -z "$app_id" ] || [ -z "$app_name" ]; then
        echo "Error: Missing arguments (app_id app_name)" >&2
        return 1
    fi

    if ! command -v flatpak >/dev/null 2>&1; then
        echo "Error: flatpak is not installed" >&2
        return 1
    fi

    local target_dir="$APPS_DIR/$app_name"
    local desktop_file="$DESKTOP_DIR/${app_id,,}.desktop"
    local flatpak_dir="$HOME/.var/app/$app_id"

    mkdir -p "$target_dir/bin" "$target_dir/sandbox_home"

    if [ -d "$flatpak_dir" ] && [ ! -L "$flatpak_dir" ]; then
        cp -r "$flatpak_dir"/. "$target_dir/sandbox_home/" 2>/dev/null
        rm -rf "$flatpak_dir"
    fi

    flatpak remote-add --user --no-gpg-verify --if-not-exists flathub "$FLATPAK_REMOTES_URL" >/dev/null 2>&1
    flatpak install --user -y flathub "$app_id" >/dev/null 2>&1

    cat << 'EOF' > "$target_dir/bin/launch"
#!/bin/bash
HERE="$(dirname "$(readlink -f "$0")")"
APP_DIR="$(dirname "$HERE")"
SANDBOX_HOME="$APP_DIR/sandbox_home"

APP_ID="TOKEN_APP_ID"
FLATPAK_DIR="$HOME/.var/app/$APP_ID"

if [ ! -L "$FLATPAK_DIR" ]; then
    rm -rf "$FLATPAK_DIR" 2>/dev/null
    ln -s "$SANDBOX_HOME" "$FLATPAK_DIR"
fi

flatpak run \
  --user \
  --device=all \
  --socket=wayland \
  --socket=x11 \
  --socket=pulseaudio \
  "$APP_ID" "$@"

rm -f "$FLATPAK_DIR" 2>/dev/null
EOF

    sed -i "s/TOKEN_APP_ID/$app_id/g" "$target_dir/bin/launch"
    chmod +x "$target_dir/bin/launch"

    local flatpak_src="$HOME/.local/share/flatpak/app/$app_id/current/active/files"
    local icon_path
    icon_path=$(find "$flatpak_src/share/icons" -name "${app_id}.svg" -o -name "${app_id}.png" 2>/dev/null | head -n 1)

    local final_icon="application-x-executable"
    if [ -n "$icon_path" ]; then
        mkdir -p "$target_dir/share"
        cp "$icon_path" "$target_dir/share/icon${icon_path##*.}"
        final_icon="$target_dir/share/icon${icon_path##*.}"
    fi

    cat << EOF > "$desktop_file"
[Desktop Entry]
Name=$app_name
Exec=$target_dir/bin/launch
Icon=$final_icon
Terminal=false
Type=Application
Categories=Utility;
EOF

    chmod +x "$desktop_file"
    update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1
}

remove_flatpak() {
    local app_id="$1"
    local app_name="$2"

    if [ -z "$app_id" ] || [ -z "$app_name" ]; then
        echo "Error: Missing arguments (app_id app_name)" >&2
        return 1
    fi

    rm -rf "$APPS_DIR/$app_name"
    rm -f "$DESKTOP_DIR/${app_id,,}.desktop"
    rm -f "$HOME/.var/app/$app_id" 2>/dev/null

    if command -v flatpak >/dev/null 2>&1; then
        flatpak uninstall --user -y "$app_id" >/dev/null 2>&1
    fi

    update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1
}

install_appimage() {
    local file_path="$1"
    local app_name="$2"
    local target_dir="$APPS_DIR/$app_name"

    mkdir -p "$target_dir/bin"
    cp "$file_path" "$target_dir/bin/$app_name.AppImage"
    chmod +x "$target_dir/bin/$app_name.AppImage"

    cat << EOF > "$DESKTOP_DIR/${app_name,,}.desktop"
[Desktop Entry]
Name=$app_name
Exec=$target_dir/bin/$app_name.AppImage
Icon=application-x-executable
Terminal=false
Type=Application
Categories=Utility;
EOF
    chmod +x "$DESKTOP_DIR/${app_name,,}.desktop"
    update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1
}

if [ -f "$1" ] && [ -z "$2" ]; then
    file_path=$(readlink -f "$1")
    file_ext="${file_path##*.}"
    app_name=$(basename "$file_path" ."$file_ext")

    case "${file_ext,,}" in
        deb|gz|tgz)
            exec linapp-legacy-installer "$file_path"
            exit 0
            ;;
        appimage)
            install_appimage "$file_path" "$app_name"
            exit 0
            ;;
        *)
            echo "Error: Unsupported file format" >&2
            exit 1
            ;;
    esac
fi

case "$1" in
    --install-flatpak)
        install_flatpak "$2" "$3"
        ;;
    --remove-flatpak)
        remove_flatpak "$2" "$3"
        ;;
    *)
        show_help
        exit 1
        ;;
esac

exit 0
